# ملفات يتجاهلها نظام إدارة الإصدارات فلا ترفع إلى المستودع
# ملف البيئة وأي نسخة أخرى منه لأنها تحتوي كلمات المرور
# ما عدا ملف المثال لأنه لا يحتوي كلمات مرور
.env
.env.*
!.env.example

# ملفات بايثون المؤقتة الناتجة عن التشغيل
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# البيئات الافتراضية تحتوي مكتبات مثبتة محلياً
# وتثبت المكتبات من ملف المكتبات بدلاً من رفعها
venv/
.venv/
env/

# ملفات إعدادات المحررات
.vscode/
.idea/
*.swp

# ملفات النظام المؤقتة
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# ملفات ناتجة عن تشغيل البرامج مثل السجلات والنسخ الاحتياطية
*.log
*.sql.gz
dumps/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan
*.pem

# Lambda build output
lambda/build/
terraform/build/

# Server env files (contain passwords)
deploy/**/.env

# Lambda test output
response.json
response.jso
