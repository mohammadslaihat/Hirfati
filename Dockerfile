# ملف بناء صورة تطبيق حرفتي
# الصورة تحتوي التطبيق وكل ما يحتاجه للتشغيل
# كل أمر في هذا الملف يضيف طبقة جديدة إلى الصورة
# السطر التالي يحدد الصورة الأساسية وهي نظام لينكس خفيف مثبت عليه بايثون
FROM python:3.12-slim

# متغيرات بيئة داخل الحاوية
# الأول يمنع بايثون من إنشاء ملفات مؤقتة
# الثاني يجعل رسائل التطبيق تظهر في سجلات دوكر فوراً
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# تحديد المجلد الحالي داخل الحاوية وتنفذ الأوامر التالية فيه
WORKDIR /app

# تثبيت المكتبات أولاً
# ننسخ ملف المكتبات وحده ثم نثبتها
# فإذا تغير كود المشروع فقط يعيد دوكر استخدام المكتبات المثبتة فيصبح البناء أسرع
# خيار عدم الحفظ المؤقت يصغر حجم الصورة
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# نسخ ملفات الواجهة الخلفية والواجهة الأمامية إلى الصورة
# الواجهة الخلفية ترسل صفحات الواجهة الأمامية لذلك نحتاج المجلدين معاً
# الملفات المستثناة مثل ملف البيئة لا تنسخ
COPY backend/ backend/
COPY frontend/ frontend/

# إنشاء مستخدم عادي وتشغيل التطبيق به بدلاً من المدير لتقليل الصلاحيات
RUN useradd --create-home --uid 1000 hirfati
USER hirfati

# الانتقال إلى مجلد الواجهة الخلفية حيث يوجد ملف التطبيق
# والتطبيق يستمع داخل الحاوية على المنفذ 5000
WORKDIR /app/backend
EXPOSE 5000

# الأمر الذي يعمل عند تشغيل الحاوية
# يشغل خادم الإنتاج التطبيق بدلاً من خادم التطوير
# يستقبل الاتصالات من خارج الحاوية على المنفذ 5000
# ويستخدم عمليتين لخدمة أكثر من طلب في نفس الوقت
# ويطبع سجل الطلبات في مخرجات الحاوية
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--access-logfile", "-", "app:app"]
