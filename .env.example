# انسخ هذا الملف باسم .env ثم ضع قيمك الخاصة (لا ترفع ملف .env إلى GitHub)

# ---------- قاعدة البيانات داخل Docker Compose ----------
# يجب أن يبقى اسم قاعدة البيانات hirfati_db (يعتمد عليه schema.sql)
MYSQL_DATABASE=hirfati_db
MYSQL_USER=hirfati_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- تطبيق Flask ----------
# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول
SECRET_KEY=
# منفذ الموقع على جهازك: http://localhost:5000
APP_PORT=5000

# ---------- اتصال Flask بقاعدة البيانات ----------
# داخل Docker Compose تُضبط هذه القيم تلقائياً (DB_HOST=db و DB_PORT=3306)
# ومستخدم قاعدة البيانات وكلمة مروره من MYSQL_USER و MYSQL_PASSWORD أعلاه.
# تُستخدم القيم التالية فقط عند تشغيل Flask مباشرة بدون Docker (python app.py):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hirfati_user
DB_PASSWORD=
DB_NAME=hirfati_db
FLASK_DEBUG=0
