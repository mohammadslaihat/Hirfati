# انسخ هذا الملف باسم ملف البيئة ثم ضع قيمك الخاصة
# لا ترفع ملف البيئة إلى المستودع
# كل سطر يتكون من اسم المتغير ثم علامة المساواة ثم القيمة دون مسافات
# القسم الأول قاعدة البيانات داخل دوكر
# يجب أن يبقى اسم قاعدة البيانات كما هو لأن ملف إنشاء الجداول يعتمد عليه
MYSQL_DATABASE=hirfati_db
# مستخدم خاص بالتطبيق في قاعدة البيانات مع كلمة مروره ويستخدمه التطبيق للاتصال
# وكلمة مرور مدير قاعدة البيانات
# اكتب كلمات مرور قوية في ملف البيئة فقط
MYSQL_USER=hirfati_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# القسم الثاني إعدادات التطبيق
# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول
SECRET_KEY=
# رقم المنفذ الذي يفتح منه الموقع على جهازك
APP_PORT=5000

# القسم الثالث اتصال التطبيق بقاعدة البيانات
# داخل دوكر تضبط هذه القيم تلقائياً
# القيم التالية تستخدم فقط عند تشغيل التطبيق مباشرة دون دوكر
# العنوان يعني هذا الجهاز نفسه والمنفذ هو المنفذ الافتراضي لقاعدة البيانات
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hirfati_user
DB_PASSWORD=
DB_NAME=hirfati_db
FLASK_DEBUG=0
